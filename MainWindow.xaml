<Window x:Class="LumaCtrl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LumaCtrl.Views"
        Title="LUMA//CTRL"
        Height="780"
        Width="1200"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D10"
        Foreground="#E6E6E6"
        FontFamily="Consolas">

    <Window.Resources>

        <!-- COLOUR SYSTEM -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#13171C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#293139"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFB84D"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#39DDEB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#78838D"/>

        <!-- PANEL -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- SECTION HEADINGS -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- RGB READOUT -->
        <Style x:Key="ReadoutStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- GENERAL BUTTON -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#20272D"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#39434B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#39DDEB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRESET TILES -->
        <Style x:Key="PresetTileStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#1B2026"/>
            <Setter Property="Foreground" Value="#0B0D10"/>
            <Setter Property="BorderBrush" Value="#303941"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder"
                                        Property="BorderBrush"
                                        Value="#39DDEB"/>
                                <Setter TargetName="TileBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SCROLLBAR THUMB -->
        <Style x:Key="LumaScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                        Background="#39434B"
                        CornerRadius="4"
                        Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                Property="Background"
                                Value="#39DDEB"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                Property="Background"
                                Value="#FFB84D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GLOBAL SCROLLBAR -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="#13171C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                           Orientation="{TemplateBinding Orientation}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LumaScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- MAIN WINDOW -->
    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,22">

            <StackPanel>
                <TextBlock Text="LUMA//CTRL"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>

                <TextBlock Text="PERSONAL LIGHTING INTERFACE"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <TextBlock Text="LOCAL INSTANCE"
                           Foreground="{StaticResource CyanBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"/>

                <TextBlock Text="WINDOWS // BLE CONTROLLER"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Right"/>

            </StackPanel>
        </Grid>

        <!-- DEVICE CONNECTION -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelStyle}"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="DEVICE // 01"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="ELK-BLEDOB"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="BE:27:E0:00:03:FA"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="ConnectionStatusText"
                               Text="DISCONNECTED"
                               Foreground="#FF6B6B"
                               FontSize="11"
                               HorizontalAlignment="Right"/>

                    <Button x:Name="ConnectButton"
                            Content="CONNECT DEVICE"
                            Click="ConnectButton_Click"
                            Margin="0,10,0,0"
                            Padding="18,9"
                            Background="#292319"
                            Foreground="#FFB84D"
                            BorderBrush="#FFB84D"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTROL AREA -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <!-- COLOUR STUDIO -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="01 // CHROMA MATRIX"
                                   Style="{StaticResource SectionTitle}"/>

                        <!-- COLOUR PREVIEW -->
                        <Border x:Name="ColorPreview"
                                Height="115"
                                CornerRadius="5"
                                Background="#FF453A"
                                Margin="0,0,0,18"/>

                        <!-- RGB VALUES -->
                        <TextBlock Text="RGB OUTPUT"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>

                        <UniformGrid Columns="3"
                                     Margin="0,10,0,18">

                            <StackPanel>
                                <TextBlock Text="RED"
                                           Foreground="#FF7777"
                                           FontSize="10"/>
                                <TextBlock x:Name="RedValue"
                                           Text="255"
                                           Style="{StaticResource ReadoutStyle}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="GREEN"
                                           Foreground="#71DB91"
                                           FontSize="10"/>
                                <TextBlock x:Name="GreenValue"
                                           Text="69"
                                           Style="{StaticResource ReadoutStyle}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="BLUE"
                                           Foreground="#6FA8FF"
                                           FontSize="10"/>
                                <TextBlock x:Name="BlueValue"
                                           Text="58"
                                           Style="{StaticResource ReadoutStyle}"/>
                            </StackPanel>

                        </UniformGrid>

                        <Border Height="1"
                                Background="#293139"
                                Margin="0,0,0,18"/>

                        <!-- COLOUR PICKER -->
                        <TextBlock Text="COLOUR SELECTOR"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,0,0,12"/>

                        <views:ColorPickerControl
                            x:Name="ColorPicker"
                            Margin="0,0,0,15"
                            ColorChanged="ColorPicker_ColorChanged"/>

                        <Border Height="1"
                                Background="#293139"
                                Margin="0,5,0,18"/>

                        <!-- FACTORY PRESETS -->
                        <TextBlock Text="CHROMA BANK // FACTORY"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="PRESET SLOTS 01 - 05"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   Margin="0,0,0,8"/>

                        <UniformGrid Columns="5"
                                     Margin="0,0,0,14">

                            <Button Content="01"
                                    Tag="#FF453A"
                                    Background="#FF453A"
                                    Click="PresetColor_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button Content="02"
                                    Tag="#39DDEB"
                                    Background="#39DDEB"
                                    Click="PresetColor_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button Content="03"
                                    Tag="#71DB91"
                                    Background="#71DB91"
                                    Click="PresetColor_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button Content="04"
                                    Tag="#B95CFF"
                                    Background="#B95CFF"
                                    Click="PresetColor_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button Content="05"
                                    Tag="#FFFFFF"
                                    Background="#FFFFFF"
                                    Click="PresetColor_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                        </UniformGrid>

                        <!-- CUSTOM PRESETS -->
                        <TextBlock Text="USER PRESETS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   Margin="0,0,0,8"/>

                        <UniformGrid Columns="5"
                                     Margin="0,0,0,8">

                            <Button x:Name="CustomPreset1Button"
                                    Content="+"
                                    Tag="0"
                                    Click="CustomPreset_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button x:Name="CustomPreset2Button"
                                    Content="+"
                                    Tag="1"
                                    Click="CustomPreset_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button x:Name="CustomPreset3Button"
                                    Content="+"
                                    Tag="2"
                                    Click="CustomPreset_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button x:Name="CustomPreset4Button"
                                    Content="+"
                                    Tag="3"
                                    Click="CustomPreset_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                            <Button x:Name="CustomPreset5Button"
                                    Content="+"
                                    Tag="4"
                                    Click="CustomPreset_Click"
                                    Style="{StaticResource PresetTileStyle}"/>

                        </UniformGrid>

                        <TextBlock Text="CLICK EMPTY SLOT TO SAVE CURRENT COLOUR"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="8"
                                   Margin="3,3,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT CONTROL PANEL -->
            <ScrollViewer Grid.Column="2"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- INTENSITY -->
                    <Border Style="{StaticResource PanelStyle}"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="02 // INTENSITY"
                                       Style="{StaticResource SectionTitle}"/>

                            <Grid>
                                <TextBlock Text="BRIGHTNESS"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBlock x:Name="BrightnessValue"
                                           Text="75%"
                                           Foreground="{StaticResource CyanBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Slider x:Name="BrightnessSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="75"
                                    Margin="0,15,0,5"
                                    ValueChanged="BrightnessSlider_ValueChanged"/>

                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="0%"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"/>

                                <TextBlock Text="100%"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- EFFECTS -->
                    <Border Style="{StaticResource PanelStyle}">

                        <StackPanel>

                            <TextBlock Text="03 // EFFECT ENGINE"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="CUSTOM LIGHTING MODES"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,16"/>

                            <!-- AURORA -->
                            <Border Background="#192127"
                                    BorderBrush="#293139"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                <StackPanel>
                                    <TextBlock Text="01 / AURORA"
                                               Foreground="{StaticResource CyanBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="CONTINUOUS COLOUR TRANSITION"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="9"
                                               Margin="0,5,0,12"/>

                                    <Button Content="START AURORA"
                                            Click="StartAurora_Click"
                                            Background="#39DDEB"
                                            Foreground="#0B0D10"
                                            BorderBrush="#39DDEB"
                                            HorizontalContentAlignment="Center"/>

                                    
                                </StackPanel>
                            </Border>

                            <Border Background="#192127"
                                BorderBrush="#293139"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,10">

                                <StackPanel>
                                    <TextBlock Text="02 / EMBER"
                                    Foreground="#FFB84D"
                                    FontSize="13"
                                    FontWeight="Bold"/>

                                    <TextBlock Text="ORGANIC FIRE / WARM FLICKER"
                                    Foreground="{StaticResource MutedBrush}"
                                    FontSize="9"
                                    Margin="0,5,0,12"/>

                                    <Button Content="START EMBER"
                                    Click="StartEmber_Click"
                                    Background="#FFB84D"
                                    Foreground="#0B0D10"
                                    BorderBrush="#FFB84D"
                                    HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- SCREEN REACTIVE -->
                            <Border Background="#192127"
                                BorderBrush="#293139"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,15">

                                <StackPanel>
                                    <TextBlock Text="03 / SCREEN REACTIVE"
                                        Foreground="#B95CFF"
                                        FontSize="13"
                                        FontWeight="Bold"/>

                                    <TextBlock Text="LIGHTING BASED ON SCREEN CONTENT"
                                        Foreground="{StaticResource MutedBrush}"
                                        FontSize="9"
                                        Margin="0,5,0,12"/>

                                    <Button Content="START SCREEN REACTIVE"
                                        Click="StartScreenReactive_Click"
                                        Background="#B95CFF"
                                        Foreground="#0B0D10"
                                        BorderBrush="#B95CFF"
                                        HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Content="■   STOP ACTIVE EFFECT"
                                    Click="StopEffect_Click"
                                    Background="#302025"
                                    Foreground="#FF7777"
                                    BorderBrush="#66343B"
                                    HorizontalContentAlignment="Center"
                                    Padding="12,11"/>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </ScrollViewer>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="0,15,0,0">

            <TextBlock Text="LUMA//CTRL"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="9"/>

            <TextBlock Text="LOCAL INSTANCE  //  BUILD 001"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="9"
                       HorizontalAlignment="Right"/>

        </Grid>

    </Grid>
</Window>
